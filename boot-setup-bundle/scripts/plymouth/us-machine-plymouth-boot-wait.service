# US Machine: gate LightDM until API + Vite are ready (stock plymouth-quit is
# masked because LightDM Conflicts= with that unit). This unit does NOT quit
# Plymouth — handoff is After=LightDM via us-machine-plymouth-quit-after-lightdm.
[Unit]
Description=US Machine Plymouth boot wait (HTTP + min splash; keep splash)
DefaultDependencies=no
After=us-machine-headless-web.service us-machine-frontend.service plymouth-start.service systemd-user-sessions.service
Wants=us-machine-headless-web.service us-machine-frontend.service
Before=lightdm.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/plymouth-quit-when-kiosk-http-ready.sh
TimeoutSec=300

[Install]
WantedBy=lightdm.service
