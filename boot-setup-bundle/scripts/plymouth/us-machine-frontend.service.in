[Unit]
Description=US Machine frontend (Vite preview on dist/) before Plymouth quit
DefaultDependencies=no
Before=plymouth-quit.service
# Ordering only — a `systemctl restart us-machine-frontend.service` for a UI redeploy
# must NOT drag the backend/EtherCAT with it, so this is After= (not Requires=/BindsTo=).
After=us-machine-headless-web.service

[Service]
Type=simple
User=@SERVICE_USER@
Group=@SERVICE_USER@
Environment=HOME=/home/@SERVICE_USER@
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/sbin/us-machine-frontend.sh
Restart=on-failure
RestartSec=3
SuccessExitStatus=143 SIGTERM

[Install]
WantedBy=multi-user.target
