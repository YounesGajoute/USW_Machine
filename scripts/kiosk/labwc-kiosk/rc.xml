<?xml version="1.0"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
	<!-- HideCursor: triggered from autostart via wtype (Alt+Super+h). Pointer stays hidden until input moves it; swayidle re-hides after idle. -->
	<keyboard>
		<keybind key="A-W-h">
			<action name="HideCursor"/>
		</keybind>
	</keyboard>
	<!-- HMI touch panel on Pi HDMI0 (DRM connector HDMI-A-1). -->
	<touch deviceName="Silicon Integrated System Co. SiS HID Touch Controller" mapToOutput="HDMI-A-1" mouseEmulation="no"/>
	<!-- Never let the GNOME keyring password dialog cover the operator UI. -->
	<windowRules>
		<windowRule identifier="gcr-prompter">
			<action name="Close"/>
		</windowRule>
		<windowRule title="Unlock Keyring">
			<action name="Close"/>
		</windowRule>
		<windowRule title="Authentication required">
			<action name="Close"/>
		</windowRule>
	</windowRules>
</openbox_config>
