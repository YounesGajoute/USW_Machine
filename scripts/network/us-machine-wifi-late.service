[Unit]
Description=US Machine: Wi-Fi autoconnect after application launch (non-blocking)
# Runs only after the app stack and kiosk handoff. Wi-Fi must NEVER delay
# backend / frontend / Plymouth / LightDM — this unit is ordered After= them
# and ExecStart returns as soon as a detached job is queued.
After=us-machine-headless-web.service us-machine-frontend.service us-machine-plymouth-boot-wait.service lightdm.service NetworkManager.service network.target
Wants=NetworkManager.service

[Service]
# oneshot exits immediately after queuing the worker. systemd-run --no-block
# puts the real connect outside this unit's cgroup so graphical.target never
# waits on association/DHCP, and the worker is not killed when we exit.
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/systemd-run --no-block --collect --unit=us-machine-wifi-late-job --description="US Machine late Wi-Fi connect" /usr/local/sbin/us-machine-wifi-late.sh
TimeoutStartSec=15

[Install]
WantedBy=graphical.target
