[Unit]
Description=US Machine: connect Wi-Fi after application launch (final boot step)
# Run only once the app stack and kiosk are up. us-machine-plymouth-boot-wait
# completes after the API + frontend HTTP are stable; lightdm starts the kiosk
# after that. Ordering after all three makes this the last boot action.
After=us-machine-headless-web.service us-machine-plymouth-boot-wait.service lightdm.service NetworkManager.service network.target
Wants=NetworkManager.service

[Service]
# Type=simple (not oneshot): the unit counts as "started" the instant the script
# execs, so graphical.target is NOT held waiting for Wi-Fi to associate. The
# script then connects (with bounded retries) in the background as the last boot
# action. A missing antenna / down AP therefore never delays boot completion.
Type=simple
ExecStart=/usr/local/sbin/us-machine-wifi-late.sh
Restart=no

[Install]
WantedBy=graphical.target
