# Optional overrides for Plymouth timing (sourced by /usr/local/sbin scripts).
# Change values here, then: sudo systemctl daemon-reload (shutdown timing is read at poweroff).

# Minimum seconds TECHMAC stays visible while waiting for Vite + API (splash stays
# up through this wait; Plymouth quits only after LightDM starts).
PLYMOUTH_MIN_BOOT_SPLASH_SEC=15

# Seconds to let LightDM quit Plymouth itself before force-quit (DRM handoff).
PLYMOUTH_LIGHTDM_QUIT_GRACE_SEC=2

# Minimum seconds shutdown / reboot / halt splash stays visible after show-splash.
# Keep short: this blocks systemd-poweroff until the hold finishes.
PLYMOUTH_MIN_SHUTDOWN_SEC=5
