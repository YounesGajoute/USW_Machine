# Copy into backend/.env or merge with existing .env (Version 2 centring development).
#   cp backend/.env.centring-dev backend/.env
# Or run: ./scripts/centring-dev-setup.sh

CENTRING_TRANSPORT=tcp
CENTRING_HOST=192.168.10.55
CENTRING_PORT=8177

# Bench only — do not use on production machine while validating motion:
# CENTRING_SKIP_INIT=1
# PRODUCTION_SKIP_CENTRING=1

# Optional tuning (defaults are usually fine):
# CENTRING_GAP_TOLERANCE_MM=1.0
# CENTRING_INIT_ATTEMPTS=3
# CENTRING_INIT_HOME_ATTEMPTS=3
