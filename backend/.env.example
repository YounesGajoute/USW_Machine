# ── SQLite API server ────────────────────────────────────────────────────────
# Port the Express API listens on (default: 3333)
PORT=3333

# Session signing secret — change in production
SESSION_SECRET=app-dev-change-me-in-production

# Override SQLite DB file path (default: data/maindata.db)
# MAIN_DATA_DB_PATH=/absolute/or/relative/path/to/maindata.db

# ── EtherCAT (Lifter / I/O via pysoem) ────────────────────────────────────────
# Default: bridge starts when the API listens (same as ./start.sh and boot stack). Unset = on.
# Set 0 / false / no / off to run the API without the bridge (e.g. dev with no hardware).
# ETHERCAT_AUTO_CONNECT=0
# Linux interface for pysoem. Prefer unset: runtime uses persisted enx* / auto-detect r8152.
# Do not set eth1 on Pi OS predictable names (USB adapter is enx*). Override only if needed:
# ETHERCAT_INTERFACE=enx00e04c680a90
# Skip DI0 panel button check during initialization (bench / dev only).
# ETHERCAT_SKIP_INIT_BUTTON=1

# Skip DI1 panel Start button check for production sequence (HMI-only start).
# ETHERCAT_SKIP_START_BUTTON=1

# Disable server-side DI0/DI1 rising-edge monitor (use frontend polling or API only).
# ETHERCAT_DISABLE_PANEL_BUTTONS=1

# Bridge init timeout (ms) — reference bridge may retry OP up to ~20×100ms plus PDO mapping.
# ETHERCAT_INIT_TIMEOUT_MS=30000
# Periodic bridge ping interval (ms). WKC mismatches are advisory only (status=ok + warning).
# ETHERCAT_HEALTH_INTERVAL_MS=10000
# Auto-reconnect on bridge disconnect (default on). Set 0 to disable.
# ETHERCAT_AUTO_RECONNECT=0
# COMM_FAILURE_THRESHOLD=3   — consecutive failed pings before bridge teardown/reconnect

# Panel two-hand Start (DI0 + DI1) — software process gate, not safety-rated.
# sequential | single  (default: sequential — hold Init, then press Start)
# PANEL_TWO_HAND_MODE=sequential
# PANEL_TWO_HAND_DISABLE=1   (forces single — overrides PANEL_TWO_HAND_MODE)
# PANEL_LONG_PRESS_MS=1200
# Panel mode affects DI0/DI1 mapping only — it does NOT gate canStartProduction.

# Production sequence delays (ms) and pick position (mm)
# PRODUCTION_DELAY_CLAMP_MS=500
# PRODUCTION_DELAY_LEVER_UP_MS=500
# PRODUCTION_DELAY_LEVER_DOWN_MS=500
# PRODUCTION_DELAY_PICK_CLAMP_MS=500
# PRODUCTION_MOVE_POSITION_MM=320
# PRODUCTION_MOVE_SPEED_MM_S=80
# PRODUCTION_SKIP_PICK_PLACE=1
# PRODUCTION_SKIP_PICK_TAIL=1
# PRODUCTION_SKIP_CENTRING_PICK_PLACE=1
# PRODUCTION_SKIP_CENTRING=1
# PRODUCTION_SKIP_VISION=1
# PRODUCTION_QUEUE_MAX_DEPTH=8
# Optional settle between centring sub-phases (ms). Default 0 — validate on machine before raising.
# CENTRING_INTER_PHASE_SETTLE_MS=0
#
# Operator cycle selection (preferred): Settings → System (BYPASS) → Production mode
#   full     — classic sequence (default, unchanged)
#   advanced — on reference load assert h_pre; open h_post at traverse output; restore h_pre after P&P home
# Env flags below remain emergency / bench overrides on top of that selection.
#
# Skip-flag notes:
#   PRODUCTION_SKIP_PICK_TAIL=1 — skip pick-station tail only (centring P&P moves still run)
#   PRODUCTION_SKIP_CENTRING_PICK_PLACE=1 — skip P&P moves inside centring only
#   PRODUCTION_SKIP_PICK_PLACE=1 — compat alias enabling BOTH of the above
#   PRODUCTION_SKIP_VISION=1 — skip inline welding/heat-shrink vision checks

# Skip motion homing during DI0 initialization (bench without Nano hardware)
# PICK_PLACE_SKIP_INIT=1
# CENTRING_SKIP_INIT=1

# ── PNOZ X2.8P safety relay (init step 1: DO9 reset → DI3 feedback) ───────────
# Skip the PNOZ reset + feedback wait during initialization (bench / no safety wiring).
# SAFETY_SKIP_PNOZ_RESET=1
# Arming sequence (restart backend after change):
#   standard — Release DO6 → preflight → Pulse DO9 → wait DI3   (default / Pilz zone 2a)
#   prime    — DO9 held high for ALL lifecycle states (never pulsed / never cleared);
#              arming = hold DO9=1 → Release DO6 → preflight → wait DI3
# PNOZ_RESET_SEQUENCE=standard
# PNOZ_RESET_SEQUENCE=prime
# DO9 PNOZ_RESET pulse width (ms) — used by standard only; ignored in prime (DO9 stays high).
# PNOZ_RESET_PULSE_MS=500
# PNOZ_FEEDBACK_TIMEOUT_MS=5000
# PNOZ_FEEDBACK_POLL_MS=100
# Treat DI3 low (0) as "reset confirmed" instead of high (1) — depends on feedback wiring.
# PNOZ_FEEDBACK_ACTIVE_LOW=1

# ── Door interlock (STCS-evo500 only) ────────────────────────────────────────
# Monitors DI6/DI5/DI7 (right-1 / right-2 / backside, 1 = open). On STCS-evo500 any
# open door drives DO6 ESTOP_CH2 to the emergency level + lifecycle SAFETY_LOCKOUT;
# recovery via Initialization.
# Disable the monitor entirely (bench / no door wiring):
# DOOR_INTERLOCK_DISABLE=1
# Door sensor poll interval (ms):
# DOOR_INTERLOCK_POLL_MS=100

# ── DO6 ESTOP_CH2 polarity (PNOZ Safety Channel 2 / S21-S22) ──────────────────
# Level written when "releasing" DO6 so Channel 2 is active (init + syncPnozChannel2).
# Default (unset / 0): DO6=0 = CH2 active (release), DO6=1 = CH2 emergency.
# Set to 1 when the field relay is wired so DO6 high = CH2 active instead:
# ESTOP_CH2_RELEASE_HIGH=1

# ── Auxiliary safety input polarity (DI8 air pressure, DI15 emergency button) ─
# Both DI8 and DI15 must read "OK" (plus the model's doors closed) before Setup may
# leave POWER_OFF for INIT. Default (unset) = active-high, matching the wiring doc:
#   DI8 AIR_PRESSURE   → 1 = pressure present/OK, 0 = low
#   DI15 ESTOP_BUTTON  → 1 = released/OK,         0 = pressed
# Uncomment to invert per how the field contact is wired:
# Treat DI8 low (0) as "pressure present/OK" instead of high (1):
# AIR_PRESSURE_ACTIVE_LOW=1
# Treat DI15 low (0) as "released/OK" instead of high (1):
# ESTOP_BUTTON_ACTIVE_LOW=1

# ── Clamp trigger modes (DI10 right / DI9 left) ───────────────────────────────
# Controls live auto-close, Start gating, and which clamps production closes.
# Restart backend after change.
#   off  (default) — DI10/DI9 unused; sequence closes both clamps (current logic)
#   di10 — DI10=1 closes right; Start requires DI10; sequence closes left only; open both
#   di9  — DI9=1 closes left;   Start requires DI9;  sequence closes right only; open both
#   both — DI10→right + DI9→left; Start requires both; sequence skips close; open both
# Legacy alias: di11 → di9
# Live auto-close only while lifecycle is RUN (ready to produce).
# Panel reopen (READY or READY_BLOCKED, mode ≠ off): single → Init opens; sequential → Start alone opens.
#   After reopen: canEnqueue=false until DI low→high and live close; then canEnqueue may be true.
#   di10→right; di9→left; both→both.
# When off, clamp DIs do not gate canStartProduction (backend/.env only — not SQLite settings).
# CLAMP_TRIGGER_MODE=off
# CLAMP_TRIGGER_MODE=di10
# CLAMP_TRIGGER_MODE=di9
# CLAMP_TRIGGER_MODE=both
# Live-monitor poll interval (ms):
# CLAMP_TRIGGER_POLL_MS=50

# ── Indicator tower + buzzer (both models) ───────────────────────────────────
# DO7 red, DO10 green, DO11 yellow, DO12 buzzer — driven by lifecycle state.
# Disable the tower entirely (bench / no tower wiring):
# INDICATOR_TOWER_DISABLE=1
# Tower poll interval (ms) and flash half-period (ms):
# TOWER_POLL_MS=250
# TOWER_FLASH_MS=500
# Buzzer one-shot duration (ms) on entering SAFETY_LOCKOUT (then auto-silences):
# TOWER_BUZZER_MS=1500

# ── Centring controller (Nano + ENC28J60, Double_Actuator TCP) ───────────────
# Defaults when unset: 192.168.10.55:8177 (backend/lib/centringMaster/centring_master.js).
# Firmware: Double_Actuator_Centring_Slave_Firmware
#   docs: Double_Actuator_Centring_Slave_Firmware/docs/double_actuator_centring_slave/MASTER_CONTROL.md
#   TCP:  Double_Actuator_Centring_Slave_Firmware/docs/double_actuator_centring_slave/TCP_MASTER_SLAVE.md
# Transport is TCP-only (READY/PING banner, idle keepalive, SETCAL, CLEARESTOP).
# CENTRING_TRANSPORT=tcp
# CENTRING_HOST=192.168.10.55
# CENTRING_PORT=8177
# CENTRING_GAP_MOVE_SPEED_DEG_S=90
# CENTRING_KEEPALIVE_MS=3000
# Legacy JSON path — used only for one-time migration into SQLite (system_settings.centring_config)
# CENTRING_CONFIG_PATH=/path/to/centring_config.json

# ── Vision Pi proxy (US Machine = Ethernet master) ─────────────────────────────
# Base URL of the vision slave (default: http://192.168.10.2:5000). /api suffix is stripped.
VISION_URL=http://192.168.10.2:5000
# VISION_SLAVE_URL=http://192.168.10.2:5000/api   # alias for CLI / tooling

# Remote key — master → slave (/api/remote/*). Matches vision Pi VISION_REMOTE_API_KEY.
# VISION_REMOTE_KEY=your-remote-secret-here
# VISION_REMOTE_API_KEY=your-remote-secret-here   # alias

# Local key — only if the slave locks /api/programs and this HMI proxies program CRUD.
# Master run-once does NOT need this. Do not confuse with VISION_REMOTE_KEY.
# VISION_LOCAL_KEY=your-local-secret-here
# VISION_LOCAL_API_KEY=your-local-secret-here     # alias

# ── Pick & Place controller (Nano ENC28J60 on machine LAN eth0) ───────────────
# Nano TCP slave (master = this Pi on 192.168.10.1)
# PICK_PLACE_HOST=192.168.10.5
# PICK_PLACE_PORT=8177
# PICK_PLACE_CONNECT_TIMEOUT_MS=10000
# PICK_PLACE_SINGLE_MOTOR=0
# Skip HOMEA/HOMEB during machine init (bench without Nano)
# PICK_PLACE_SKIP_INIT=1
# Legacy JSON path — used only for one-time migration into SQLite (system_settings.pick_place_config)
# PICK_PLACE_CONFIG_PATH=/path/to/pick_place_config.json

# ── Reference broadcast (USB serial, e.g. FTDI FT232) ─────────────────────────
# After a valid scan/select, the API sends the canonical DB name to both paths.
# REFERENCE_SERIAL_WELD_PATH=/dev/ttyUSB0
# REFERENCE_SERIAL_SHRINK_PATH=/dev/ttyUSB1
# Shared defaults (used when per-port vars below are unset):
# REFERENCE_SERIAL_BAUD=9600
# REFERENCE_SERIAL_LINE_ENDING=CRLF
# Optional per machine (override shared baud / line ending for that port only):
# REFERENCE_SERIAL_WELD_BAUD=9600
# REFERENCE_SERIAL_SHRINK_BAUD=9600
# REFERENCE_SERIAL_WELD_LINE_ENDING=CRLF
# REFERENCE_SERIAL_SHRINK_LINE_ENDING=CRLF

# Communication supervisor (eth0 TCP + EtherCAT health)
# COMM_HEALTH_INTERVAL_MS=5000
# COMM_FAILURE_THRESHOLD=3
# ETHERCAT_AUTO_RECONNECT=1
# ETHERCAT_RECONNECT_MAX_BACKOFF_MS=30000
# CENTRING_CONNECT_RETRIES=3
# CENTRING_CONNECT_RETRY_MS=2000
# CENTRING_CONNECT_TIMEOUT_MS=8000
